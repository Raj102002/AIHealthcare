# Groq API - get from https://console.groq.com
# Used for chat generation + reranking (openai/gpt-oss-120b), query rewriting
# (openai/gpt-oss-20b), speech-to-text (whisper-large-v3-turbo), and
# text-to-speech (playai-tts). See lib/models.ts for the single source of truth.
GROQ_API_KEY=your_groq_api_key_here

# Back4App - get from https://dashboard.back4app.com → App Settings → Security & Keys
NEXT_PUBLIC_BACK4APP_APP_ID=your_back4app_app_id_here
NEXT_PUBLIC_BACK4APP_JS_KEY=your_back4app_javascript_key_here

# Upstash Vector - get from https://console.upstash.com/vector (free tier)
# Create the index with a built-in embedding model attached (e.g.
# mixedbread-ai/mxbai-embed-large-v1) so upserts/queries can send raw text and
# Upstash embeds it server-side - no separate embeddings API key needed.
# Only used by scripts/ingest.ts (offline) and the retrieval layer (request time).
UPSTASH_VECTOR_REST_URL=your_upstash_vector_rest_url_here
UPSTASH_VECTOR_REST_TOKEN=your_upstash_vector_rest_token_here

# Optional. Daily Groq token-budget threshold (lib/metrics.ts) — logs a warning
# once usage crosses this within a single warm function instance's lifetime.
# Defaults to 90000 (Groq's free/on-demand tier caps at 100,000 tokens/day).
# DAILY_TOKEN_BUDGET=90000

# Optional, NEVER commit a real value here. Only needed once, as an ephemeral
# env var when running `npm run setup-indexes` from a developer machine — see
# docs/database-optimization.md. The deployed app never reads this.
# BACK4APP_MASTER_KEY=

# Optional. Python binary used by app/api/vestibular-screening/route.ts to run
# vestibular-ai/run_screening.py. Defaults to trying "python3" then "python" on
# PATH; set this only if neither resolves to a Python with
# vestibular-ai/requirements.txt installed. See docs/deployment.md section 7 —
# this feature has no Python runtime in production (Netlify) or in the
# current Docker image, so it 501s gracefully there regardless of this var.
# VESTIBULAR_PYTHON=
